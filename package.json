{
  "name": "risk-admin",
  "version": "5.6.1",
  "description": "CYLTFR Admin Web App",
  "main": "index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build:css": "bin/build-css",
    "build": " bin/build ",
    "test:jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" DOTENV_CONFIG_PATH=./.env.unittest jest --no-cache  --detectOpenHandles --runInBand --forceExit",
    "test": "npm run test:lint && npm run test:audit && npm run test:jest",
    "test:audit": "npm audit --omit dev --json | bin/audit-check",
    "test:lint": "eslint",
    "postinstall": "npm run build",
    "build:container": "docker build . -t ltfmgmt:v1",
    "package:container": "docker save --output ltfmgmt.tar ltfmgmt:v1",
    "start:container": "docker run -v ~/.aws/:/root/.aws:ro -p 3001:3000 --rm --env-file .env --name ltfmgmt ltfmgmt:v1",
    "debug:container": "docker run -v ~/.aws/:/root/.aws:ro -p 3000:3000 -p 9229:9229 --rm --env-file .env --name ltfmgmt ltfmgmt:v1 node --inspect-brk=0.0.0.0:9229 index.js"
  },
  "author": "defra.gov.uk",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@hapi/bell": "13.1.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-object": "3.0.1",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "@turf/bbox": "7.3.5",
    "@turf/helpers": "7.3.5",
    "@turf/intersect": "7.3.5",
    "@turf/turf": "7.3.5",
    "blipp": "4.0.2",
    "dotenv": "17.4.2",
    "govuk-frontend": "6.4.0",
    "hapi-pino": "13.0.0",
    "joi": "18.2.3",
    "jsonexport": "3.2.0",
    "moment-timezone": "0.6.3",
    "node-cron": "4.6.0",
    "notifications-node-client": "8.4.0",
    "nunjucks": "3.2.4",
    "ogr2ogr": "7.0.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "neostandard": "0.13.0",
    "sass": "1.101.0"
  },
  "jest": {
    "setupFiles": [
      "dotenv/config"
    ],
    "automock": false,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/public/**/*",
      "!server/src/js/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "test/output"
  },
  "audit-check": {
    "threshold": "moderate",
    "ogr2ogr": {
      "version": "6.0.1",
      "minimatch": {}
    },
    "neostandard": {
      "version": "0.12.2",
      "minimatch": {}
    },
    "jest": {
      "version": "30.2.0",
      "minimatch": {}
    },
    "eslint": {
      "version": "9.39.3",
      "minimatch": {}
    }
  }
}
